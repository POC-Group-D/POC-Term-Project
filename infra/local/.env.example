# Copy to .env to override defaults. .env is git-ignored; never put secrets here
# that are meant for the cloud deployment.
IMAGE_REGISTRY=us-central1-docker.pkg.dev/online-boutique-ci/microservices-demo
IMAGE_TAG=v0.10.7
FRONTEND_PORT=8080
LOAD_USERS=10
LOAD_RATE=1

# v2 agent (docker-compose.v2.yml). Secrets: keep them only in .env.
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
COSMOS_ENDPOINT=
COSMOS_KEY=

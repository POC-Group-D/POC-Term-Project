# Copy to .env to override defaults. .env is git-ignored; never put secrets here
# that are meant for the cloud deployment.
IMAGE_REGISTRY=us-central1-docker.pkg.dev/online-boutique-ci/microservices-demo
IMAGE_TAG=v0.10.7
FRONTEND_PORT=8080
LOAD_USERS=10
LOAD_RATE=1

# v2 agent (docker-compose.v2.yml). Defaults use the local Ollama model.
# To use a hosted OpenAI-compatible API instead, set all three:
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
COSMOS_ENDPOINT=
COSMOS_KEY=
